{
    "name": "bedriox/protocol",
    "description": "Single-version Minecraft: Bedrock Edition protocol primitives for Bedriox.",
    "type": "library",
    "license": "GPL-3.0-only",
    "homepage": "https://bedriox.com",
    "require": {
        "ext-openssl": "*",
        "ext-zlib": "*",
        "php": "^8.4",
        "php-64bit": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Bedriox\\Protocol\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bedriox\\Protocol\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "check:ci": [
            "composer validate --strict",
            "composer audit --locked",
            "@analyse"
        ],
        "check": [
            "@check:ci",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
